{
  "name": "balwyn-gate-automation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/build-help-index.mjs && next build --webpack && node scripts/check-no-purple.mjs .next/static",
    "start": "next start --hostname 0.0.0.0",
    "test": "npm run build && node --test tests/*.test.mjs && python3 -m unittest discover -s gate-controller/tests && python3 -m unittest discover -s controller-agent/tests -p 'test_*.py' && python3 -m unittest discover -s pi-door-service/tests -v && python3 -m unittest discover -s deploy/mildura/tests",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern archive",
    "db:generate": "drizzle-kit generate",
    "test:doors": "node --test tests/remote-open.test.mjs && python3 -m unittest discover -s pi-door-service/tests -v && python3 -m unittest discover -s deploy/mildura/tests",
    "test:netlify-gate": "python3 -m unittest discover -s tests -p 'test_netlify_gate.py' -v",
    "typecheck": "tsc --noEmit",
    "build:render": "npm run build",
    "check:colours": "node scripts/check-no-purple.mjs .next/static"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.1",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@electric-sql/pglite": "^0.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vinext": "0.0.50",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  },
  "type": "module",
  "displayName": "Balwyn High School Gate Operations"
}
