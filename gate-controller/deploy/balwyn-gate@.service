# One instance per gate:  systemctl enable --now balwyn-gate@TF-ENTRY
# Settings: /etc/balwyn-gate/%i.env    Credential: /etc/balwyn-gate/%i.token (root:root, mode 600)
# State + audit log: /var/lib/balwyn-gate/%i/
[Unit]
Description=Balwyn gate controller for %i (Magic Keys portal)
# No dependency on dev-gpiochip0.device: Raspberry Pi OS does not tag gpiochip
# devices for systemd, so that unit never becomes active and Requires= on it
# failed the service after the device timeout. The GPIO chip exists from early
# boot; if it is missing the controller stops with an error and is restarted.
# Deliberately NOT After=network-online.target (15 Oct 2026): the controller polls
# with back-off and works without the network, and waiting for the network delayed
# the moment the relay pin is claimed OFF by up to two minutes after boot.
# Never give up restarting: a unit left "failed" sends no heartbeat, so the portal
# would only show it offline. ExecStopPost forces the relays OFF after each attempt.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=balwyn-gate
Group=gpio
WorkingDirectory=/opt/balwyn-gate-controller
EnvironmentFile=/etc/balwyn-gate/%i.env
Environment=PYTHONUNBUFFERED=1
# The credential file stays root-only; systemd hands the service a private copy.
LoadCredential=token:/etc/balwyn-gate/%i.token
Environment=CONTROLLER_TOKEN_FILE=%d/token
StateDirectory=balwyn-gate/%i
StateDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -m balwyn_gate_controller check-config
ExecStart=/usr/bin/python3 -m balwyn_gate_controller run
# After EVERY stop - clean exit, crash, watchdog kill, out-of-memory kill - drive
# this gate's relay pins OFF again. A killed controller never runs its own
# clean-up, and the relay must not be left in whatever state the kernel leaves
# the released pin. "-" = a failure here never blocks the restart.
ExecStopPost=-/usr/bin/python3 -m balwyn_gate_controller relays-off
# systemd restarts the controller if its main loop stops reporting for 15 s.
# The relay is released on every stop and is claimed OFF on every start.
WatchdogSec=15
Restart=always
RestartSec=3
KillSignal=SIGTERM
# ExecStopPost (relays-off) shares this limit and must be allowed to finish: python start-up plus
# its 0.2 s settle can exceed 5 s on a busy Pi, and a killed relays-off leaves the pin undriven.
TimeoutStopSec=20

# Hardening: no privileges, read-only system, only the GPIO chip as a device.
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
DevicePolicy=closed
DeviceAllow=/dev/gpiochip0 rw
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
