# /etc/balwyn-gate/SIDE-ENTRY.env   (copy per gate; owner root, mode 640, group balwyn-gate)
# Locinox VENUS pedestrian-gate operator, 2-channel relay board, both gates on one Pi.
# Every value is checked at start-up; a wrong or missing value stops the service
# with a message naming the setting. Nothing here is a secret: the credential
# lives in /etc/balwyn-gate/SIDE-ENTRY.token (mode 600).
#
# IMPORTANT: comments go on their OWN line. systemd does not strip a comment
# written after a value ("RELAY_PIN=17  # note" makes the value "17  # note"),
# and the controller refuses to start if any value contains '#'.

PORTAL_URL=https://magickeys-balwyn-portal.com
GATE_ID=SIDE-ENTRY

# ---- Relay board: any 2-channel board driven by one GPIO pin per channel ----
# PROPOSED pin plan for TWO gates on ONE Pi (INSTALL.md section 1d). Nothing
# here has been tested on real hardware.
#   GPIO 22 -> TF-ENTRY gate relay      GPIO 23 -> SIDE-ENTRY gate relay
# Both pins are held LOW by the Pi from power-on, so a board that switches ON
# when its pin is HIGH stays off through boot. If your board is active-low
# (switches ON when the pin is LOW), set RELAY_ACTIVE_LOW=true AND change the
# config.txt line in INSTALL.md section 1d to op,dh: this file does not decide
# that, test B0 does.
RELAY_BOARD=generic

# ---- Wiring (BCM GPIO numbers, not header pin numbers) --------------------
# Relay channel that drives this gate. COM/NO go across Venus input IN2 and its
# common (IN2 set to Control device, Normally Open, "Hold to keep open").
RELAY_PIN=23
# UNVERIFIED: the polarity of the board actually used. false = ON when HIGH.
RELAY_ACTIVE_LOW=false
# REQUIRED. Reed made when the gate is fully closed.
CLOSED_REED_PIN=24
# Reed made when fully open.
OPEN_REED_PIN=25
# Contact of the small 24 V relay whose coil is on Venus OUT2 (24V AUX). Closed =
# the Venus has power and its outputs are not shut down. It does NOT report a
# Venus fault or a blocked gate. "none" = monitor-only: the gate reports but can
# never be commanded.
SAFETY_INPUT=6
# Reeds and contacts switch the input to 0 V (GND) when made.
INPUT_ACTIVE_LOW=true
# Internal pull-up. Use "off" only with external resistors.
INPUT_PULL=up

# ---- Access-board unlock: NOT USED with a Venus -------------------------------
# The Venus releases its own lock (OUT1) before it moves. If the lock stays on
# the school's ACB board instead, use the older plan in INSTALL.md section 1b.
UNLOCK_RELAY_PIN=none
UNLOCK_SENSE_PIN=none
UNLOCK_PULSE_S=0.5
UNLOCK_CONFIRM_TIMEOUT_S=2
UNLOCK_LEAD_S=0.5

# ---- Timing: set from the stopwatch measurements at commissioning ----------
# VENUS TRAP: on "Hold to keep open" the Venus CLOSES the gate again if the
# contact is released while the gate is still opening (Venus manual p. 13).
# So this pulse must last LONGER than the measured full open travel. Maximum 10 s.
# 8 is a PLACEHOLDER, not a measurement: set it at test C1 from the stopwatch.
CYCLE_PULSE_S=8
# Measured full open travel + 50 %. Placeholder until C1.
TRAVEL_TIMEOUT_S=20
# Venus pause time (default 5 s) + close travel + 50 %. Placeholder until C1.
AUTO_CLOSE_TIMEOUT_S=60
DEBOUNCE_S=0.3

# ---- Behaviour ---------------------------------------------------------------
# Weekly schedules, facility-hire bookings and automation rules. START WITH
# false: any schedule or booking already saved in the portal would otherwise
# start holding the gate open the moment DRY_RUN is set to false. Set true
# after test C1 passes, before tests C2 and C3.
SCHEDULE_CONTROL=false
# A schedule/booking hold is never kept longer than 14 h.
HOLD_MAX_S=50400
# A schedule/booking hold is released after 5 min without the portal.
# A fire / evacuation hold is never released by this timer.
NETWORK_LOSS_RELEASE_S=300
# Holds and pulses are dropped if the controller loop freezes for this long.
LOOP_STALL_S=10
# START WITH true. Set false only for supervised on-site commissioning.
DRY_RUN=true
