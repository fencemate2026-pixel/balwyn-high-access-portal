# /etc/balwyn-gate/SIDE-ENTRY.env   (copy per gate; owner root, mode 640, group balwyn-gate)
# Every value is checked at start-up; a wrong or missing value stops the service
# with a message naming the setting. Nothing here is a secret: the credential
# lives in /etc/balwyn-gate/SIDE-ENTRY.token (mode 600).
#
# IMPORTANT: comments go on their OWN line. systemd does not strip a comment
# written after a value ("RELAY_PIN=17  # note" makes the value "17  # note"),
# and the controller refuses to start if any value contains '#'.

PORTAL_URL=https://magickeys-balwyn-portal.com
GATE_ID=SIDE-ENTRY

# ---- Relay board: Keyestudio KS0212 RPI 4-channel Relay Shield --------------
# PROPOSED pin plan for TWO gates on ONE Pi. Confirm every pin against the
# actual wiring before use; nothing here has been tested on the real shield.
# The shield's relays are fixed to GPIO 4, 22, 6, 26 and switch ON when the
# pin is HIGH (Keyestudio sample code), so RELAY_ACTIVE_LOW=false. Which relay
# on the shield answers to which GPIO: watch its LED during test B0.
#   GPIO 22 -> TF-ENTRY gate      GPIO 26 -> SIDE-ENTRY gate
#   GPIO 4  -> TF-ENTRY unlock    GPIO 6  -> SIDE-ENTRY unlock
# Inputs (reeds, safety, K1 sense) use other pins: never 4, 22, 6 or 26.
RELAY_BOARD=keyestudio-ks0212

# ---- Wiring (BCM GPIO numbers, not header pin numbers) --------------------
# Relay channel that drives the gate. COM/NO go to F70/IPU36 terminals 34 (AP)
# and 32 (COM) of THIS gate's control unit.
RELAY_PIN=26
RELAY_ACTIVE_LOW=false
# REQUIRED. Reed made when the gate is fully closed.
CLOSED_REED_PIN=23
# Reed made when fully open (fitted at Balwyn).
OPEN_REED_PIN=24
# F70/IPU36 COR contact 19-18 with parameter 18 = 03 (closed = no alarm, power
# OK). "none" = monitor-only: the gate reports but can never be commanded.
SAFETY_INPUT=25
# Reeds and contacts switch the input to 0 V (GND) when made.
INPUT_ACTIVE_LOW=true
# Internal pull-up. Use "off" only with external resistors.
INPUT_PULL=up

# ---- Access-board unlock (optional; see INSTALL.md section 1b) -------------
# Second relay channel. Its COM/NO go across the ACB-004 exit-button input for
# this gate's door: P1 and the GND beside it (P2/P3/P4 for doors 2-4). Never
# the S1-S4 terminals: those are door-sensor inputs. "none" = not fitted.
# SIDE-ENTRY: ACB-004 exit-button input P2 (door 2, to be confirmed) and the GND beside it (CONFIRM which
# door number this gate is in the S4A software before wiring).
UNLOCK_RELAY_PIN=6
# Pi input on the spare contact of the 12 V relay (K1) that the ACB door relay
# drives. Made = the board has unlocked the door. "none" = not fitted.
UNLOCK_SENSE_PIN=16
# Exit-button press, seconds (0.3 to 2). The board's own unlock time (set in
# the S4A software, e.g. 5 s) decides how long the lock stays released.
UNLOCK_PULSE_S=0.5
# Wait this long for the board's unlock signal; if it never comes the gate
# relay is not driven and the command is reported as failed.
UNLOCK_CONFIRM_TIMEOUT_S=2
# Delay after the unlock is confirmed before the gate relay is driven.
UNLOCK_LEAD_S=0.5

# ---- Timing: set from the stopwatch measurements at commissioning ----------
# Manual OPEN pulse on AP, seconds. The F70 manual gives no minimum pulse: 1 s
# is RJL's choice, confirm at test C1. F70 parameter A2 must be non-zero for
# the gate to auto-close.
CYCLE_PULSE_S=1
# Measured full open travel + 50 %.
TRAVEL_TIMEOUT_S=30
# Measured auto-close delay + close travel + 50 %.
AUTO_CLOSE_TIMEOUT_S=90
DEBOUNCE_S=0.3

# ---- Behaviour ---------------------------------------------------------------
# Weekly schedules, facility-hire bookings and automation rules. START WITH
# false: any schedule or booking already saved in the portal would otherwise
# start holding the gate open the moment DRY_RUN is set to false. Set true
# after test C1 passes, before tests C2 and C3.
SCHEDULE_CONTROL=false
# A schedule/booking hold is never kept longer than 14 h.
HOLD_MAX_S=50400
# A schedule/booking hold is released after 5 min without the portal.
# A fire / evacuation hold is never released by this timer.
NETWORK_LOSS_RELEASE_S=300
# Holds and pulses are dropped if the controller loop freezes for this long.
LOOP_STALL_S=10
# START WITH true. Set false only for supervised on-site commissioning.
DRY_RUN=true
