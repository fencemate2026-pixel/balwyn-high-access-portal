# /etc/balwyn-gate/TF-ENTRY.env   (copy per gate; owner root, mode 640, group balwyn-gate)
# Every value is checked at start-up; a wrong or missing value stops the service
# with a message naming the setting. Nothing here is a secret: the credential
# lives in /etc/balwyn-gate/TF-ENTRY.token (mode 600).

PORTAL_URL=https://magickeys-balwyn-portal.com
GATE_ID=TF-ENTRY

# ---- Wiring (BCM GPIO numbers, not header pin numbers) --------------------
RELAY_PIN=17              # relay COM/NO -> F70/IPU36 terminals 34 (AP) and 32 (COM)
RELAY_ACTIVE_LOW=true     # most opto relay boards switch ON when the input is pulled low
CLOSED_REED_PIN=22        # REQUIRED. Made when the gate is fully closed
OPEN_REED_PIN=23          # magnetic reed, made when fully open (fitted at Balwyn)
SAFETY_INPUT=24           # F70/IPU36 COR contact 19-18 with parameter 18 = 03 (closed = no alarm, power OK). "none" = monitor-only
INPUT_ACTIVE_LOW=true     # reeds/contacts switch the input to 0 V (GND) when made
INPUT_PULL=up             # internal pull-up; use "off" only with external resistors

# ---- Timing: set from the stopwatch measurements at commissioning ----------
CYCLE_PULSE_S=1           # manual OPEN pulse on AP. The F70 manual gives no minimum pulse: 1 s is RJL's choice, confirm at test C1. A2 must be non-zero to auto-close
TRAVEL_TIMEOUT_S=30       # measured full open travel + 50 %
AUTO_CLOSE_TIMEOUT_S=90   # measured auto-close delay + close travel + 50 %
DEBOUNCE_S=0.3

# ---- Behaviour ---------------------------------------------------------------
SCHEDULE_CONTROL=true         # accept weekly schedules, booking windows and automation rules
HOLD_MAX_S=50400              # a schedule/booking hold is never kept longer than 14 h
NETWORK_LOSS_RELEASE_S=300    # schedule/booking hold released after 5 min without the portal
LOOP_STALL_S=10               # holds and pulses dropped if the controller loop freezes
DRY_RUN=true                  # START WITH true. Set false only for supervised on-site commissioning
