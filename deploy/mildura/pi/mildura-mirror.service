[Unit]
Description=Mildura gate mirror (outbound HTTPS only; optional portal commands)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mildura-mirror/mildura_mirror.py
Environment=MIRROR_ENV=/etc/mildura-mirror.env
Restart=always
RestartSec=30
Nice=15
IOSchedulingClass=idle
MemoryMax=64M
# Runs as the gate database owner (the gate app's own user). No root, no GPIO group needed.
User=rjlcommercial
StateDirectory=mildura-mirror
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Phase 2: the ONLY writable path outside the state dir is the gate app's data directory (SQLite
# needs the directory for its journal). Only mildura_commands.py writes there, and only when
# MIRROR_CONTROL=1. Phase 1 (control off) never opens the database for writing.
ReadWritePaths=/home/rjlcommercial/boomgate
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
