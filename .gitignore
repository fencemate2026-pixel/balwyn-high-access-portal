# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.netlify/

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
__pycache__/
*.pyc

# Local relay credentials, journal and Python cache
/pi-door-service/*.sqlite3*
/pi-door-service/.env
__pycache__/
*.pyc
*.tsbuildinfo
/supabase/.temp/
*.env
*.env

# Nested/unrelated local project folders that must never be tracked by this
# repository (they caused duplicate-path TypeScript build failures on Render
