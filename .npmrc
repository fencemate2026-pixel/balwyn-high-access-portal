fund=false
update-notifier=false
cache=.sites-runtime/npm-cache
# Next.js needs TypeScript and the CSS toolchain during production builds.
include=dev
# `audit` is intentionally left at its default (on). Installs still pass
# --no-audit (CI, Dockerfile, install-ci.sh) to keep them fast and
# deterministic; the dedicated "npm audit" step in .github/workflows/verify.yml
# is what is meant to catch new high/critical findings (AUDIT_DEPS.md P3-1).
# Disabling it here would silence that step too, since --no-audit always wins
# but a plain `npm audit` would otherwise inherit `audit=false` from this file.
