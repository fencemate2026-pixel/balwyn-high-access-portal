[Unit]
Description=Balwyn High School fail-safe gate relay bridge
After=network-online.target dev-gpiochip0.device
Wants=network-online.target
Requires=dev-gpiochip0.device
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=balwyn-gate
Group=gpio
EnvironmentFile=/etc/balwyn-relay-agent.env
Environment=PYTHONUNBUFFERED=1
Environment=STATE_DIRECTORY=/var/lib/balwyn-relay-agent
ExecStart=/opt/balwyn-relay-agent/venv/bin/python /opt/balwyn-relay-agent/balwyn_relay_agent.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/balwyn-relay-agent

[Install]
WantedBy=multi-user.target
