PORTAL_URL=https://balwyn-gate-automation.info581042.chatgpt.site
GATE_ID=TF-ENTRY
CONTROLLER_TOKEN=REDACTED

# BCM GPIO numbers. Dedicated OPEN and CLOSE inputs are mandatory; a toggle/PP
# input is deliberately unsupported because a remote command cannot prove direction.
OPEN_RELAY_PIN=REPLACE_WITH_VERIFIED_BCM_PIN
CLOSE_RELAY_PIN=REPLACE_WITH_VERIFIED_BCM_PIN
OPEN_LIMIT_PIN=REPLACE_WITH_VERIFIED_BCM_PIN
CLOSED_LIMIT_PIN=REPLACE_WITH_VERIFIED_BCM_PIN
SAFETY_OK_PIN=REPLACE_WITH_VERIFIED_BCM_PIN
ESTOP_PIN=REPLACE_WITH_VERIFIED_BCM_PIN

RELAY_ACTIVE_LOW=REPLACE_WITH_TRUE_OR_FALSE
INPUT_ACTIVE_LOW=REPLACE_WITH_TRUE_OR_FALSE
INPUT_BIAS=REPLACE_WITH_PULL_UP_PULL_DOWN_OR_OFF
PULSE_SECONDS=REPLACE_WITH_COMMISSIONED_VALUE
MOVEMENT_TIMEOUT_SECONDS=REPLACE_WITH_COMMISSIONED_VALUE

# Keep false until the school-approved operating schedule and risk assessment
# have been signed off during commissioning.
ENABLE_SCHEDULE_CONTROL=false
