+++ b/pi-door-service/door_service.py
@@ -0,0 +1,253 @@
+#!/usr/bin/env python3
+"""Compass ACB-004 isolated relay triggers. Open only; no position feedback."""
+from __future__ import annotations
+
+import hmac
+import json
+import logging
+import os
+import re
+import signal
+import sqlite3
+import threading
+import uuid
+from contextlib import contextmanager
+from dataclasses import dataclass
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+LOG = logging.getLogger("compass-door-open")
+
+
+@dataclass(frozen=True)
+class Config:
+    token: str
+    pins: tuple[int, ...]
+    pulse_ms: int = 500
+    mode: str = "mock"
+    active_low: bool = True
+    chip: int = 0
+    journal: str = "door-open-state.sqlite3"
+
+    def __post_init__(self):
+        if len(self.token) < 32 or not self.token.isascii() or any(c.isspace() for c in self.token) or self.token.startswith("REPLACE_"):
+            raise ValueError("DOOR_API_TOKEN must be an ASCII token of at least 32 characters")
+        if len(self.pins) != 4 or len(set(self.pins)) != 4 or any(type(p) is not int or not 2 <= p <= 27 for p in self.pins):
+            raise ValueError("DOOR_GPIO_PINS requires four distinct BCM pins in door 1,2,3,4 order (2..27)")
+        if type(self.pulse_ms) is not int or not 300 <= self.pulse_ms <= 800:
+            raise ValueError("DOOR_PULSE_MS must be an integer between 300 and 800")
+        if self.mode not in {"mock", "dry-run", "hardware"}:
+            raise ValueError("DOOR_MODE must be mock, dry-run or hardware")
+        if type(self.active_low) is not bool or type(self.chip) is not int or self.chip < 0:
+            raise ValueError("Invalid GPIO polarity or chip")
+
+    @classmethod
+    def from_env(cls):
+        mode = os.environ.get("DOOR_MODE", "mock")
+        if mode == "hardware" and (not os.environ.get("DOOR_GPIO_PINS") or os.environ.get("DOOR_ACTIVE_LOW") not in {"true", "false"}):
+            raise ValueError("Hardware mode requires explicit verified DOOR_GPIO_PINS and DOOR_ACTIVE_LOW")
+        return cls(
+            token=os.environ.get("DOOR_API_TOKEN", ""),
+            pins=tuple(int(p.strip()) for p in os.environ.get("DOOR_GPIO_PINS", "17,27,22,23").split(",")),
+            pulse_ms=int(os.environ.get("DOOR_PULSE_MS", "500")), mode=mode,
+            active_low=os.environ.get("DOOR_ACTIVE_LOW", "true") == "true",
+            chip=int(os.environ.get("DOOR_GPIO_CHIP", "0")),
+            journal=os.environ.get("DOOR_JOURNAL", "door-open-state.sqlite3"),
+        )
+
+
+class MockOutputs:
+    def __init__(self, config: Config):
+        self.states = {pin: False for pin in config.pins}
+
+    def write(self, pin: int, active: bool):
+        self.states[pin] = active
+
+    def close(self):
+        for pin in self.states:
+            self.write(pin, False)
+
+
+class GpioOutputs:
+    def __init__(self, config: Config):
+        import lgpio  # Imported only for an explicitly configured hardware run.
+        self.gpio, self.config, self.claimed = lgpio, config, []
+        self.handle = lgpio.gpiochip_open(config.chip)
+        try:
+            for pin in config.pins:
+                lgpio.gpio_claim_output(self.handle, pin, int(config.active_low))
+                self.claimed.append(pin)
+        except BaseException:
+            self.close()
+            raise
+
+    def write(self, pin: int, active: bool):
+        level = int(not active) if self.config.active_low else int(active)
+        self.gpio.gpio_write(self.handle, pin, level)
+
+    def close(self):
+        error = None
+        for pin in self.claimed:
+            try:
+                self.write(pin, False)
+                self.gpio.gpio_free(self.handle, pin)
+            except Exception as exc:
+                error = exc
+        self.claimed.clear()
+        self.gpio.gpiochip_close(self.handle)
+        if error:
+            raise RuntimeError("GPIO cleanup failed; inspect relay outputs locally") from error
+
+
+class DoorController:
+    def __init__(self, config: Config, outputs=None):
+        self.config = config
+        self.outputs = outputs or (GpioOutputs(config) if config.mode == "hardware" else MockOutputs(config))
+        self.lock = threading.Lock()
+        self.stopping = threading.Event()
+        self.faulted = False
+        try:
+            Path(config.journal).parent.mkdir(parents=True, exist_ok=True)
+            with self.database() as db:
+                db.execute("CREATE TABLE IF NOT EXISTS requests (id TEXT PRIMARY KEY, door INTEGER NOT NULL, result TEXT)")
+            os.chmod(config.journal, 0o600)
+        except BaseException:
+            self.outputs.close()
+            raise
+
+    @contextmanager
+    def database(self):
+        db = sqlite3.connect(self.config.journal, timeout=2)
+        try:
+            with db:
+                yield db
+        finally:
+            db.close()
+
+    def open(self, door: int, request_id: str):
+        if type(door) is not int or door not in range(1, 5):
+            return 404, {"error": "Door must be 1, 2, 3 or 4"}
+        try:
+            if str(uuid.UUID(request_id)) != request_id:
+                raise ValueError()
+        except (ValueError, AttributeError):
+            return 400, {"error": "A canonical UUID Idempotency-Key is required"}
+        if not self.lock.acquire(blocking=False):
+            return 409, {"error": "A relay pulse is already in progress; no command was queued"}
+        try:
+            if self.stopping.is_set() or self.faulted:
+                return 503, {"error": "Relay service stopped or faulted; inspect locally"}
+            with self.database() as db:
+                row = db.execute("SELECT door, result FROM requests WHERE id = ?", (request_id,)).fetchone()
+                if row:
+                    if row[0] != door or row[1] is None:
+                        return 409, {"error": "Request already reserved; no repeat pulse. Inspect the original result locally"}
+                    code, result = json.loads(row[1])
+                    return code, {**result, "replayed": True}
+                # Commit before touching hardware, including across a Pi restart.
+                db.execute("INSERT INTO requests (id, door) VALUES (?, ?)", (request_id, door))
+            pin = self.config.pins[door - 1]
+            LOG.info("event=open_started request_id=%s door=%d mode=%s pulse_ms=%d", request_id, door, self.config.mode, self.config.pulse_ms)
+            try:
+                try:
+                    self.outputs.write(pin, True)
+                    interrupted = self.stopping.wait(self.config.pulse_ms / 1000)
+                finally:
+                    self.outputs.write(pin, False)
+                if interrupted:
+                    raise RuntimeError("Shutdown interrupted the pulse")
+                code = 200
+                result = {"status": "pulsed" if self.config.mode == "hardware" else "dry_run", "door": door,
+                          "pulse_ms": self.config.pulse_ms, "position": "unknown", "sensor_feedback": False,
+                          "request_id": request_id}
+            except Exception:
+                self.faulted = True
+                code, result = 503, {"error": "Pulse failed or interrupted; physical outcome unknown. Inspect locally", "request_id": request_id}
+                LOG.error("event=open_failed request_id=%s door=%d", request_id, door)
+            with self.database() as db:
+                db.execute("UPDATE requests SET result = ? WHERE id = ?", (json.dumps([code, result]), request_id))
+            LOG.info("event=open_finished request_id=%s door=%d http_status=%d", request_id, door, code)
+            return code, result
+        except sqlite3.Error:
+            self.faulted = True
+            LOG.error("event=journal_failed request_id=%s door=%d", request_id, door)
+            return 503, {"error": "Execution journal unavailable; no automatic retry. Inspect locally"}
+        finally:
+            self.lock.release()
+
+    def close(self):
+        self.stopping.set()
+        with self.lock:
+            self.outputs.close()
+
+
+def make_handler(controller: DoorController):
+    class Handler(BaseHTTPRequestHandler):
+        server_version = "DoorOpen/1"
+
+        def setup(self):
+            super().setup()
+            self.connection.settimeout(5)
+
+        def log_message(self, *args):
+            pass  # Never log raw URLs, tokens or user-supplied headers.
+
+        def respond(self, status: int, payload: dict):
+            encoded = json.dumps(payload).encode()
+            self.send_response(status)
+            self.send_header("Content-Type", "application/json")
+            self.send_header("Content-Length", str(len(encoded)))
+            self.send_header("Cache-Control", "no-store")
+            self.send_header("Connection", "close")
+            self.end_headers()
+            self.wfile.write(encoded)
+
+        def do_POST(self):
+            headers = self.headers.get_all("Authorization", [])
+            valid = len(headers) == 1 and hmac.compare_digest(headers[0].encode(), ("Bearer " + controller.config.token).encode())
+            if not valid:
+                LOG.warning("event=unauthorized")
+                return self.respond(401, {"error": "Unauthorized"})
+            match = re.fullmatch(r"/doors/([1-4])/open", self.path)
+            if not match:
+                return self.respond(404, {"error": "Only POST /doors/{1-4}/open is supported"})
+            # Commands have no tunable request body: pin, duration and polarity are local configuration.
+            if self.headers.get("Transfer-Encoding") or self.headers.get("Content-Length", "0") != "0":
+                return self.respond(400, {"error": "Send an empty body"})
+            status, payload = controller.open(int(match[1]), self.headers.get("Idempotency-Key", ""))
+            self.respond(status, payload)
+
+        def do_GET(self):
+            self.respond(405, {"error": "POST required; no sensor endpoint is available"})
+
+        do_PUT = do_DELETE = do_PATCH = do_OPTIONS = do_GET
+
+    return Handler
+
+
+def main():
+    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+    controller = DoorController(Config.from_env())
+    try:
+        server = ThreadingHTTPServer((os.environ.get("DOOR_BIND", "127.0.0.1"), int(os.environ.get("DOOR_PORT", "8080"))), make_handler(controller))
+    except BaseException:
+        controller.close()
+        raise
+    server.daemon_threads = False
+
+    def stop(*_):
+        controller.stopping.set()
+        threading.Thread(target=server.shutdown, daemon=True).start()
+
+    signal.signal(signal.SIGTERM, stop)
+    signal.signal(signal.SIGINT, stop)
+    LOG.info("event=service_started mode=%s", controller.config.mode)
+    try:
+        server.serve_forever(poll_interval=0.2)
+    finally:
+        server.server_close()
+        controller.close()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/pi-door-service/tests/test_door_service.py b/pi-door-service/tests/test_door_service.py
new file mode 100644
index 0000000..7a9d209
--- /dev/null
+++ b/pi-door-service/tests/test_door_service.py
@@ -0,0 +1,179 @@
+import http.client
+import importlib.util
+import json
+import sqlite3
+import sys
+import tempfile
+import threading
+import time
+import unittest
+import uuid
+from pathlib import Path
+from unittest.mock import patch, Mock
+
+spec = importlib.util.spec_from_file_location("door_service", Path(__file__).parents[1] / "door_service.py")
+service = importlib.util.module_from_spec(spec)
+sys.modules[spec.name] = service
+spec.loader.exec_module(service)
+TOKEN = "test-only-token-that-is-longer-than-32-chars"
+PINS = (17, 27, 22, 23)
+
+
+class RecordingOutputs(service.MockOutputs):
+    def __init__(self, config):
+        super().__init__(config)
+        self.writes = []
+        self.activated = threading.Event()
+        self.fail = False
+
+    def write(self, pin, active):
+        self.writes.append((pin, active, time.monotonic()))
+        super().write(pin, active)
+        if active:
+            self.activated.set()
+            if self.fail:
+                raise OSError("Injected GPIO failure")
+
+
+class DoorServiceTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.config = service.Config(TOKEN, PINS, pulse_ms=300, mode="hardware", journal=str(Path(self.temp.name) / "requests.sqlite3"))
+        self.outputs = RecordingOutputs(self.config)
+        self.controller = service.DoorController(self.config, self.outputs)
+        self.server = service.ThreadingHTTPServer(("127.0.0.1", 0), service.make_handler(self.controller))
+        self.thread = threading.Thread(target=lambda: self.server.serve_forever(poll_interval=0.01))
+        self.thread.start()
+
+    def tearDown(self):
+        self.server.shutdown()
+        self.thread.join()
+        self.server.server_close()
+        self.controller.close()
+        self.temp.cleanup()
+
+    def request(self, path="/doors/1/open", token=TOKEN, method="POST", request_id=None, body=None):
+        conn = http.client.HTTPConnection(*self.server.server_address, timeout=3)
+        headers = {"Idempotency-Key": request_id if request_id is not None else str(uuid.uuid4())}
+        if token is not None:
+            headers["Authorization"] = "Bearer " + token
+        conn.request(method, path, body=body, headers=headers)
+        response = conn.getresponse()
+        result = response.status, json.loads(response.read())
+        conn.close()
+        return result
+
+    def test_each_route_pulses_only_its_own_channel_and_reports_unknown(self):
+        for door, pin in enumerate(PINS, 1):
+            with self.subTest(door=door):
+                start = len(self.outputs.writes)
+                status, body = self.request(f"/doors/{door}/open")
+                self.assertEqual(status, 200)
+                self.assertEqual(body["door"], door)
+                self.assertEqual(body["status"], "pulsed")
+                self.assertEqual(body["position"], "unknown")
+                self.assertFalse(body["sensor_feedback"])
+                writes = self.outputs.writes[start:]
+                self.assertEqual([(p, on) for p, on, _ in writes], [(pin, True), (pin, False)])
+                self.assertGreaterEqual(writes[1][2] - writes[0][2], 0.29)
+                self.assertLess(writes[1][2] - writes[0][2], 0.8)
+                self.assertFalse(any(self.outputs.states.values()))
+
+    def test_rejected_requests_never_touch_gpio(self):
+        for token in [None, "incorrect"]:
+            self.assertEqual(self.request(token=token)[0], 401)
+        for path in ["/doors/0/open", "/doors/5/open", "/doors/-1/open", "/doors/1/close", "/doors/1/open?pin=23", "/doors/01/open"]:
+            self.assertEqual(self.request(path)[0], 404)
+        self.assertEqual(self.request(method="GET")[0], 405)
+        self.assertEqual(self.request(body='{"pin":23,"pulse_ms":999}')[0], 400)
+        self.assertEqual(self.request(request_id="")[0], 400)
+        self.assertEqual(self.outputs.writes, [])
+
+    def test_concurrent_command_is_rejected_without_queueing(self):
+        first = threading.Thread(target=self.request)
+        first.start()
+        self.assertTrue(self.outputs.activated.wait(1))
+        self.assertEqual(self.request("/doors/2/open")[0], 409)
+        first.join()
+        self.assertEqual([(p, on) for p, on, _ in self.outputs.writes], [(17, True), (17, False)])
+
+    def test_gpio_exception_deenergises_channel_and_latches_fault(self):
+        self.outputs.fail = True
+        self.assertEqual(self.request()[0], 503)
+        self.assertFalse(any(self.outputs.states.values()))
+        self.assertEqual(self.request("/doors/2/open")[0], 503)
+        self.assertEqual(len(self.outputs.writes), 2)
+
+    def test_replay_and_restart_do_not_repeat_pulse(self):
+        key = str(uuid.uuid4())
+        self.assertEqual(self.request(request_id=key)[0], 200)
+        self.assertTrue(self.request(request_id=key)[1]["replayed"])
+        self.assertEqual(self.request("/doors/2/open", request_id=key)[0], 409)
+        outputs = RecordingOutputs(self.config)
+        restarted = service.DoorController(self.config, outputs)
+        self.assertTrue(restarted.open(1, key)[1]["replayed"])
+        self.assertEqual(outputs.writes, [])
+        restarted.close()
+        self.assertEqual(len(self.outputs.writes), 2)
+
+    def test_interrupted_journal_entry_never_replays(self):
+        key = str(uuid.uuid4())
+        with sqlite3.connect(self.config.journal) as db:
+            db.execute("INSERT INTO requests VALUES (?, 1, NULL)", (key,))
+        self.assertEqual(self.request(request_id=key)[0], 409)
+        self.assertEqual(self.outputs.writes, [])
+
+    def test_shutdown_interrupts_pulse_and_turns_output_off(self):
+        result = []
+        thread = threading.Thread(target=lambda: result.append(self.request()))
+        thread.start()
+        self.assertTrue(self.outputs.activated.wait(1))
+        self.controller.stopping.set()
+        thread.join()
+        self.assertEqual(result[0][0], 503)
+        self.assertFalse(any(self.outputs.states.values()))
+
+    def test_mock_mode_never_imports_gpio_and_reports_dry_run(self):
+        config = service.Config(TOKEN, PINS, 300, "dry-run", journal=str(Path(self.temp.name) / "mock.sqlite3"))
+        with patch.dict(sys.modules, {"lgpio": None}):
+            controller = service.DoorController(config)
+            self.assertIsInstance(controller.outputs, service.MockOutputs)
+            self.assertEqual(controller.open(4, str(uuid.uuid4()))[1]["status"], "dry_run")
+            controller.close()
+
+    def test_active_low_and_high_hardware_start_inactive(self):
+        for low in [True, False]:
+            gpio = Mock()
+            gpio.gpiochip_open.return_value = 9
+            config = service.Config(TOKEN, PINS, active_low=low)
+            with patch.dict(sys.modules, {"lgpio": gpio}):
+                outputs = service.GpioOutputs(config)
+                self.assertEqual([c.args for c in gpio.gpio_claim_output.call_args_list], [(9, p, int(low)) for p in PINS])
+                outputs.write(22, True)
+                gpio.gpio_write.assert_called_with(9, 22, int(not low))
+                outputs.close()
+                self.assertEqual([c.args for c in gpio.gpio_write.call_args_list][-4:], [(9, p, int(low)) for p in PINS])
+
+    def test_configuration_rejects_unsafe_values(self):
+        for pulse in [299, 801, 500.5, True]:
+            with self.assertRaises(ValueError):
+                service.Config(TOKEN, PINS, pulse_ms=pulse)
+        for pins in [(17, 17, 22, 23), (17, 22), (0, 27, 22, 23)]:
+            with self.assertRaises(ValueError):
+                service.Config(TOKEN, pins)
+        with patch.dict("os.environ", {"DOOR_MODE": "hardware", "DOOR_API_TOKEN": TOKEN}, clear=True):
+            with self.assertRaises(ValueError):
+                service.Config.from_env()
+        with self.assertRaises(ValueError):
+            service.Config("REPLACE_WITH_A_UNIQUE_RANDOM_TOKEN", PINS)
+
+    def test_auth_token_is_never_logged(self):
+        with self.assertLogs(service.LOG, level="INFO") as logs:
+            self.request(token="bad-token-in-log-check")
+            self.request()
+        self.assertNotIn(TOKEN, " ".join(logs.output))
+        self.assertNotIn("bad-token-in-log-check", " ".join(logs.output))
+
+
+if __name__ == "__main__":
+    unittest.main()
