# ============================================================================
# Magic Keys - Balwyn High School portal
# CORRECTED environment list
#
# Source of truth: render.yaml in the repo (read directly), NOT the
# configuration document. That document described a Cloudflare Worker with
# D1 and R2 - this app is a Next.js server on Render using Supabase.
# Several variable names in that document do not exist in this codebase.
#
# This file REPLACES the earlier template. Discard the earlier one.
# ============================================================================


# ---------------------------------------------------------------------------
# 1. DATABASE  (MISSING - portal cannot store login challenges without these)
#
# Every sign-in writes a single-use challenge row via the Supabase edge
# function /functions/v1/balwyn-portal-db. Without these two, sign-in
# returns 503 "Google sign-in is temporarily unavailable".
#
# lib/supabase-server.ts rejects the URL unless it is https, has no
# username/password, and has NO path - bare origin only.
# ---------------------------------------------------------------------------

SUPABASE_URL=https://aevsfrxqyvtuycufffxk.supabase.co

# Service-role JWT for the above project. BYPASSES row-level security.
# Never commit it, never put it in browser code.
# Supabase dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# 2. GOOGLE SIGN-IN  (already set correctly - leave as is)
# ---------------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=204580877625-qv3ja6tgcpdhol9cgmvj12le6q4prla9.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAILS=info@rjlcommercialgroup.com,sgg@balwynhs.vic.edu.au


# ---------------------------------------------------------------------------
# 3. SESSION  (already set - but see note)
#
# NOTE: RENDER_MIGRATION.md says to PRESERVE the original value from the
# previous host, not generate a new one. The value generated in this session
# is cryptographically fine, but if any existing sessions or stored data
# depend on the old secret, the original should be recovered instead.
# ---------------------------------------------------------------------------

PORTAL_SESSION_SECRET=


# ---------------------------------------------------------------------------
# 4. OPERATOR ACCOUNTS  (real names from render.yaml)
#
# Note PORTAL_ALLOWED_EMAILS - the configuration document called this
# GOOGLE_ALLOWED_EMAILS only. Both exist and are different settings.
# Leave blank until the original values are recovered from the previous host.
# Do NOT generate replacement password hashes as a shortcut - the migration
# notes explicitly warn against this.
# ---------------------------------------------------------------------------

PORTAL_USERNAME=
PORTAL_OPERATOR_EMAIL=
PORTAL_PASSWORD_HASH=
PORTAL_PASSWORD_SALT=
PORTAL_ALLOWED_EMAILS=
PORTAL_OWNER_EMAIL=
PORTAL_ROLE=

PORTAL_SECONDARY_USERNAME=
PORTAL_SECONDARY_OPERATOR_EMAIL=
PORTAL_SECONDARY_OPERATOR_PHONE=
PORTAL_SECONDARY_PASSWORD_HASH=
PORTAL_SECONDARY_PASSWORD_SALT=
PORTAL_SECONDARY_ROLE=


# ---------------------------------------------------------------------------
# 5. SETTINGS UNLOCK
# Set BOTH or NEITHER. One alone fails closed and locks you out of
# System settings, schedules and automation rules.
# ---------------------------------------------------------------------------

PORTAL_SETTINGS_PASSWORD_HASH=
PORTAL_SETTINGS_PASSWORD_SALT=


# ---------------------------------------------------------------------------
# 6. AI ASSISTANCE  (optional)
# ---------------------------------------------------------------------------

AI_PROVIDER=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
# 7. BUILD
# ---------------------------------------------------------------------------

NODE_VERSION=22
NODE_ENV=production


# ---------------------------------------------------------------------------
# DELETED - these do NOT exist in this codebase
#
#   MICROSOFT_OAUTH_CLIENT_ID
#   MICROSOFT_OAUTH_CLIENT_SECRET
#   MICROSOFT_ALLOWED_ACCOUNTS
#
# Only lib/auth-settings.ts mentions Microsoft, and render.yaml defines no
# Microsoft variables. The Entra setup steps in the configuration document
# do not apply to the deployed code.
#
#   SUPABASE_DATABASE_URL  - legacy name, superseded by SUPABASE_URL
# ---------------------------------------------------------------------------
